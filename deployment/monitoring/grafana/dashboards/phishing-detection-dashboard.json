{
  "dashboard": {
    "id": null,
    "title": "Phishing Detection System Dashboard",
    "tags": ["phishing", "security", "ml"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "System Overview",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"gateway\"}",
            "legendFormat": "Gateway Status"
          },
          {
            "expr": "up{job=\"text\"}",
            "legendFormat": "Text Service Status"
          },
          {
            "expr": "up{job=\"url\"}",
            "legendFormat": "URL Service Status"
          },
          {
            "expr": "up{job=\"image\"}",
            "legendFormat": "Image Service Status"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Request Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_requests_total[5m])",
            "legendFormat": "{{job}} - {{method}} {{endpoint}}"
          }
        ],
        "yAxes": [
          {
            "label": "Requests/sec",
            "min": 0
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 3,
        "title": "Response Time",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "95th percentile - {{job}}"
          },
          {
            "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "50th percentile - {{job}}"
          }
        ],
        "yAxes": [
          {
            "label": "Seconds",
            "min": 0
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 4,
        "title": "Threat Detection Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(phishing_detections_total[5m])",
            "legendFormat": "Phishing Detections/sec"
          },
          {
            "expr": "rate(legitimate_classifications_total[5m])",
            "legendFormat": "Legitimate Classifications/sec"
          }
        ],
        "yAxes": [
          {
            "label": "Classifications/sec",
            "min": 0
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
      },
      {
        "id": 5,
        "title": "Model Performance",
        "type": "graph",
        "targets": [
          {
            "expr": "model_confidence_score",
            "legendFormat": "Avg Confidence - {{model_type}}"
          },
          {
            "expr": "model_accuracy",
            "legendFormat": "Accuracy - {{model_type}}"
          }
        ],
        "yAxes": [
          {
            "label": "Score",
            "min": 0,
            "max": 1
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
      },
      {
        "id": 6,
        "title": "Error Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_requests_total{status=~\"5..\"}[5m])",
            "legendFormat": "5xx Errors - {{job}}"
          },
          {
            "expr": "rate(http_requests_total{status=~\"4..\"}[5m])",
            "legendFormat": "4xx Errors - {{job}}"
          }
        ],
        "yAxes": [
          {
            "label": "Errors/sec",
            "min": 0
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24}
      },
      {
        "id": 7,
        "title": "Resource Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total[5m])",
            "legendFormat": "CPU Usage - {{container}}"
          },
          {
            "expr": "container_memory_usage_bytes / container_spec_memory_limit_bytes",
            "legendFormat": "Memory Usage - {{container}}"
          }
        ],
        "yAxes": [
          {
            "label": "Usage %",
            "min": 0,
            "max": 1
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}
      },
      {
        "id": 8,
        "title": "Continuous Learning Metrics",
        "type": "graph",
        "targets": [
          {
            "expr": "continuous_learning_retrain_events_total",
            "legendFormat": "Retrain Events"
          },
          {
            "expr": "continuous_learning_model_performance",
            "legendFormat": "Model Performance"
          },
          {
            "expr": "continuous_learning_data_fetch_events_total",
            "legendFormat": "Data Fetch Events"
          }
        ],
        "yAxes": [
          {
            "label": "Count",
            "min": 0
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 32}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  }
}
