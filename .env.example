# PhishingLens - example environment. Copy to .env and adjust.
# The consolidated API (serve/app.py) runs with sensible defaults and needs NONE
# of these to work; they are optional tuning + full-stack settings.

# --- Consolidated API (serve/app.py) ---
# MODEL_ID=cybersectony/phishing-email-detection-distilbert_v2.4.1
# LOCAL_MODEL_DIR=              # point at a local model dir to skip the HF download
# TEXT_THRESHOLD=0.50
# URL_THRESHOLD=0.50
# ENABLE_NETWORK_CHECKS=false   # set true to allow DNS/redirect probing (slower)

# --- Frontend (Vite) ---
# Set in the Vercel dashboard, or a frontend/.env file for local builds.
VITE_API_URL=http://localhost:8000

# --- Full microservice stack only (deployment/newdeployment) ---
# Optional threat-intel enrichment for the URL service. Leave blank to disable.
OTX_API_KEY=
PHISHTANK_API_KEY=
MISP_API_KEY=
MISP_URL=
SERVICE_USE_EXTERNAL_THRESHOLD=true
EXTERNAL_TEXT_THRESHOLD=0.125
